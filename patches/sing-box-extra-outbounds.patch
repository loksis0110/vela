@@ -0,0 +1,13 @@
+package include
+
+import "github.com/sagernet/sing-box/adapter/outbound"
+
+// ExtraOutbounds lets programs embedding sing-box add their own outbound
+// types (Vela: the "xray" outbound). Fill it from an init function.
+var ExtraOutbounds []func(registry *outbound.Registry)
+
+func registerExtraOutbounds(registry *outbound.Registry) {
+	for _, register := range ExtraOutbounds {
+		register(registry)
+	}
+}
